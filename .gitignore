# 本地构建副本、历史备份、会话记录与发布产物
/.build-ui/
/.backup/
/.operit/
/dist/
/device-mask-v*.zip

# 保留可复用构建脚本，排除工具下载、缓存、日志和密钥
/.build-tools/*
!/.build-tools/Setup-AndroidEnv.ps1
!/.build-tools/Verify-Ui.ps1
!/.build-tools/Verify-Delivery.py
!/.build-tools/Run-ModuleTests-Msys.py
/tools/*-sources.jar

